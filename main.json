{
  "name": "ESP32 to Blockchain Voting Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "esp32/vote",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "id": "webhook-esp32",
      "name": "ESP32 Webhook"
    },
    {
      "parameters": {
        "action": "hash",
        "type": "sha256",
        "value": "={{ $json.body.voterID }}_Election2026",
        "dataPropertyName": "voterHash"
      },
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        470,
        300
      ],
      "id": "crypto-hash",
      "name": "Hash Voter ID"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/blockchain/vote",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"voterHash\": \"{{ $json.voterHash }}\",\n  \"party\": \"{{ $('ESP32 Webhook').item.json.body.party }}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        690,
        300
      ],
      "id": "http-blockchain",
      "name": "Send to Blockchain Bridge"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": {{ $json.success }},\n  \"transactionHash\": \"{{ $json.transactionHash }}\",\n  \"etherscanLink\": \"{{ $json.etherscanLink }}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        910,
        300
      ],
      "id": "respond-webhook",
      "name": "Respond to ESP32"
    }
  ],
  "connections": {
    "ESP32 Webhook": {
      "main": [
        [
          {
            "node": "Hash Voter ID",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Hash Voter ID": {
      "main": [
        [
          {
            "node": "Send to Blockchain Bridge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send to Blockchain Bridge": {
      "main": [
        [
          {
            "node": "Respond to ESP32",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}